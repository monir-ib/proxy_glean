{
  "$schema": "https://app.kilo.ai/config.json",
  "disabled_providers": [],
  "provider": {
    "glean": {
      "name": "glean",
      "npm": "@ai-sdk/openai-compatible",
      "limit": { "context": 400000, "output": 8192 },
      "options": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "claude-sonnet-5-fast": {
          "name": "claude-sonnet-5-fast"
        },
        "claude-sonnet-5-advanced": {
          "name": "claude-sonnet-5-advanced"
        },
        "claude-opus-5-fast": {
          "name": "claude-opus-5-fast"
        },
        "claude-opus-5-advanced": {
          "name": "claude-opus-5-advanced"
        }
      }
    }
  },
  "permission": {
    "bash": "allow"
  },
  "indexing": {
    "enabled": true
  }
}

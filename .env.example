# Generated automatically by: python get_credentials.py
# Copy to .env only if you want to fill it in by hand.

# Tenant backend host, e.g. https://acme-be.glean.com
GLEAN_BACKEND_URL=

# Session cookies. Captured from the browser cookie jar; the important ones are
# glean-session-store and okta-saml-hosted-login-session-store.
GLEAN_COOKIE=

# Sent as the X-Scio-Actas header.
GLEAN_EMAIL=

# Frontend build string from the captured chat request, e.g.
# fe-release-2026-08-06-a27dd3d. Refresh if Glean ships a frontend update.
GLEAN_CLIENT_VERSION=

# Glean answers messages[0], so newest-first ordering is required. Leave true.
GLEAN_REVERSE_MESSAGES=true

# Optional
GLEAN_TIMEZONE_OFFSET=420
GLEAN_TIMEOUT=300
LOG_LEVEL=INFO

# Advisory limits reported via /v1/models
GLEAN_CONTEXT_WINDOW=200000
GLEAN_MAX_OUTPUT_TOKENS=8192
